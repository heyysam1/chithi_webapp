# Upstash Redis (https://console.upstash.com -> Redis -> REST API)
# Leave both blank for local dev: the app falls back to an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32+ random chars. Peppers the sha256 of access tokens and recovery passcodes.
# Rotating this invalidates every live mailbox. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_PEPPER=

# 32+ random chars. Salts the viewer hash used for rate limiting and dedup.
IP_SALT=

# Public origin, used for building shareable links and OG metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: default locale, "en" or "bn"
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Maintenance Cron Secret (for GET /api/cron/cleanup)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Permanent owner mailbox (never expires). Disabled by default.
# SECURITY WARNING: this is a PUBLIC repo — NEVER commit real values here.
# Set them in Vercel's environment variables and in your local .env.local
# (which is gitignored). The app fails fast at startup if
# PERMANENT_MAILBOX_ENABLED=true but any of the three is missing/invalid.
# The owner logs in through the normal /recover page (name + username +
# 6-digit passcode); no separate UI exists.
# ---------------------------------------------------------------------------
PERMANENT_MAILBOX_ENABLED=false
PERMANENT_MAILBOX_NAME=
PERMANENT_MAILBOX_USERNAME=
# Exactly 6 digits (the /recover UI takes a 6-digit passcode)
PERMANENT_MAILBOX_PASSCODE=

